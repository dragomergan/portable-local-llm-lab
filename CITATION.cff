title: "Portable Local LLM Lab: Offline LLM, RAG, Terminology, and Graph Workflows for Translation Studies"
version: "1.0.0"
date-released: "2026-10-26"
license: MIT
repository-code: "https://github.com/dragomergan/portable-local-llm-lab"
