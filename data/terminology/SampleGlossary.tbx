<?xml version="1.0" encoding="UTF-8"?>
<!--
  Sample English-Turkish IT glossary (100 entries) for the Portable Local LLM Lab.
  Written from scratch for this project: the definitions and example sentences are original.
  Released under CC0 1.0 (public domain dedication): https://creativecommons.org/publicdomain/zero/1.0/
  Structure follows TBX-Basic (ISO 30042). It has not been checked against the official schema.
-->
<tbx style="dca" type="TBX-Basic" xml:lang="en" xmlns="urn:iso:std:iso:30042:ed-2">
  <tbxHeader>
    <fileDesc>
      <titleStmt><title>Sample English-Turkish IT Glossary</title></titleStmt>
      <sourceDesc><p>Original sample created for the Portable Local LLM Lab project. CC0 1.0.</p></sourceDesc>
    </fileDesc>
  </tbxHeader>
  <text>
    <body>
      <conceptEntry id="c001">
        <descrip type="subjectField">information technology</descrip>
        <langSec xml:lang="en">
          <descrip type="definition">The record that identifies a user or organization in a system and stores their sign-in details and settings.</descrip>
          <termSec>
            <term>account</term>
            <termNote type="partOfSpeech">noun</termNote>
            <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
            <descrip type="context">Create an account to save your progress.</descrip>
          </termSec>
        </langSec>
        <langSec xml:lang="tr">
          <termSec>
            <term>hesap</term>
            <termNote type="partOfSpeech">noun</termNote>
            <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
            <descrip type="context">İlerlemenizi kaydetmek için bir hesap oluşturun.</descrip>
          </termSec>
        </langSec>
      </conceptEntry>
      <conceptEntry id="c002">
        <descrip type="subjectField">information technology</descrip>
        <langSec xml:lang="en">
          <descrip type="definition">A finite sequence of well-defined steps for solving a problem or carrying out a computation.</descrip>
          <termSec>
            <term>algorithm</term>
            <termNote type="partOfSpeech">noun</termNote>
            <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
          </termSec>
        </langSec>
        <langSec xml:lang="tr">
          <termSec>
            <term>algoritma</term>
            <termNote type="partOfSpeech">noun</termNote>
            <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
          </termSec>
        </langSec>
      </conceptEntry>
      <conceptEntry id="c003">
        <descrip type="subjectField">information technology</descrip>
        <langSec xml:lang="en">
          <descrip type="definition">A program designed to help a user carry out a specific task.</descrip>
          <termSec>
            <term>application</term>
            <termNote type="partOfSpeech">noun</termNote>
            <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
          </termSec>
        </langSec>
        <langSec xml:lang="tr">
          <termSec>
            <term>uygulama</term>
            <termNote type="partOfSpeech">noun</termNote>
            <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
          </termSec>
        </langSec>
      </conceptEntry>
      <conceptEntry id="c004">
        <descrip type="subjectField">information technology</descrip>
        <langSec xml:lang="en">
          <descrip type="definition">A document, picture, or other file that travels along with an email message.</descrip>
          <termSec>
            <term>attachment</term>
            <termNote type="partOfSpeech">noun</termNote>
            <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
            <descrip type="context">Open the attachment to read the report.</descrip>
          </termSec>
        </langSec>
        <langSec xml:lang="tr">
          <termSec>
            <term>ek</term>
            <termNote type="partOfSpeech">noun</termNote>
            <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
            <descrip type="context">Raporu okumak için eki açın.</descrip>
          </termSec>
        </langSec>
      </conceptEntry>
      <conceptEntry id="c005">
        <descrip type="subjectField">information technology</descrip>
        <langSec xml:lang="en">
          <descrip type="definition">The process of checking that a user or device is who or what it claims to be.</descrip>
          <termSec>
            <term>authentication</term>
            <termNote type="partOfSpeech">noun</termNote>
            <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
          </termSec>
        </langSec>
        <langSec xml:lang="tr">
          <termSec>
            <term>kimlik doğrulama</term>
            <termNote type="partOfSpeech">noun</termNote>
            <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
          </termSec>
        </langSec>
      </conceptEntry>
      <conceptEntry id="c006">
        <descrip type="subjectField">information technology</descrip>
        <langSec xml:lang="en">
          <descrip type="definition">The process of deciding which actions or resources an authenticated user may use.</descrip>
          <termSec>
            <term>authorization</term>
            <termNote type="partOfSpeech">noun</termNote>
            <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
          </termSec>
        </langSec>
        <langSec xml:lang="tr">
          <termSec>
            <term>yetkilendirme</term>
            <termNote type="partOfSpeech">noun</termNote>
            <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
          </termSec>
        </langSec>
      </conceptEntry>
      <conceptEntry id="c007">
        <descrip type="subjectField">information technology</descrip>
        <langSec xml:lang="en">
          <descrip type="definition">A copy of data that is stored separately so that it can be restored after loss or damage.</descrip>
          <termSec>
            <term>backup</term>
            <termNote type="partOfSpeech">noun</termNote>
            <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
            <descrip type="context">Make a backup before you update the system.</descrip>
          </termSec>
        </langSec>
        <langSec xml:lang="tr">
          <termSec>
            <term>yedek</term>
            <termNote type="partOfSpeech">noun</termNote>
            <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
            <descrip type="context">Sistemi güncellemeden önce bir yedek alın.</descrip>
          </termSec>
        </langSec>
      </conceptEntry>
      <conceptEntry id="c008">
        <descrip type="subjectField">information technology</descrip>
        <langSec xml:lang="en">
          <descrip type="definition">The maximum amount of data that a connection can carry in a given period of time.</descrip>
          <termSec>
            <term>bandwidth</term>
            <termNote type="partOfSpeech">noun</termNote>
            <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
          </termSec>
        </langSec>
        <langSec xml:lang="tr">
          <termSec>
            <term>bant genişliği</term>
            <termNote type="partOfSpeech">noun</termNote>
            <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
          </termSec>
        </langSec>
      </conceptEntry>
      <conceptEntry id="c009">
        <descrip type="subjectField">information technology</descrip>
        <langSec xml:lang="en">
          <descrip type="definition">A saved shortcut to a web page or to a position in a document.</descrip>
          <termSec>
            <term>bookmark</term>
            <termNote type="partOfSpeech">noun</termNote>
            <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
          </termSec>
        </langSec>
        <langSec xml:lang="tr">
          <termSec>
            <term>yer imi</term>
            <termNote type="partOfSpeech">noun</termNote>
            <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
          </termSec>
        </langSec>
      </conceptEntry>
      <conceptEntry id="c010">
        <descrip type="subjectField">information technology</descrip>
        <langSec xml:lang="en">
          <descrip type="definition">The process of starting a computer and loading its operating system.</descrip>
          <termSec>
            <term>boot</term>
            <termNote type="partOfSpeech">noun</termNote>
            <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
          </termSec>
        </langSec>
        <langSec xml:lang="tr">
          <termSec>
            <term>önyükleme</term>
            <termNote type="partOfSpeech">noun</termNote>
            <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
          </termSec>
        </langSec>
      </conceptEntry>
      <conceptEntry id="c011">
        <descrip type="subjectField">information technology</descrip>
        <langSec xml:lang="en">
          <descrip type="definition">A program that is used to view and move between web pages.</descrip>
          <termSec>
            <term>browser</term>
            <termNote type="partOfSpeech">noun</termNote>
            <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
          </termSec>
        </langSec>
        <langSec xml:lang="tr">
          <termSec>
            <term>tarayıcı</term>
            <termNote type="partOfSpeech">noun</termNote>
            <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
          </termSec>
        </langSec>
      </conceptEntry>
      <conceptEntry id="c012">
        <descrip type="subjectField">information technology</descrip>
        <langSec xml:lang="en">
          <descrip type="definition">A flaw in software that makes it behave in an unintended way.</descrip>
          <termSec>
            <term>bug</term>
            <termNote type="partOfSpeech">noun</termNote>
            <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
          </termSec>
        </langSec>
        <langSec xml:lang="tr">
          <termSec>
            <term>hata</term>
            <termNote type="partOfSpeech">noun</termNote>
            <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
          </termSec>
        </langSec>
      </conceptEntry>
      <conceptEntry id="c013">
        <descrip type="subjectField">information technology</descrip>
        <langSec xml:lang="en">
          <descrip type="definition">An on-screen control that a user selects to start an action.</descrip>
          <termSec>
            <term>button</term>
            <termNote type="partOfSpeech">noun</termNote>
            <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
          </termSec>
        </langSec>
        <langSec xml:lang="tr">
          <termSec>
            <term>düğme</term>
            <termNote type="partOfSpeech">noun</termNote>
            <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
          </termSec>
        </langSec>
      </conceptEntry>
      <conceptEntry id="c014">
        <descrip type="subjectField">information technology</descrip>
        <langSec xml:lang="en">
          <descrip type="definition">A small, fast store that keeps copies of recently or often used data so that they can be fetched again quickly.</descrip>
          <termSec>
            <term>cache</term>
            <termNote type="partOfSpeech">noun</termNote>
            <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
            <descrip type="context">Clear the cache if the page does not load correctly.</descrip>
          </termSec>
        </langSec>
        <langSec xml:lang="tr">
          <termSec>
            <term>önbellek</term>
            <termNote type="partOfSpeech">noun</termNote>
            <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
            <descrip type="context">Sayfa doğru yüklenmezse önbelleği temizleyin.</descrip>
          </termSec>
        </langSec>
      </conceptEntry>
      <conceptEntry id="c015">
        <descrip type="subjectField">information technology</descrip>
        <langSec xml:lang="en">
          <descrip type="definition">A small box that a user can select or clear to turn an option on or off.</descrip>
          <termSec>
            <term>checkbox</term>
            <termNote type="partOfSpeech">noun</termNote>
            <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
          </termSec>
        </langSec>
        <langSec xml:lang="tr">
          <termSec>
            <term>onay kutusu</term>
            <termNote type="partOfSpeech">noun</termNote>
            <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
          </termSec>
        </langSec>
      </conceptEntry>
      <conceptEntry id="c016">
        <descrip type="subjectField">information technology</descrip>
        <langSec xml:lang="en">
          <descrip type="definition">A computer or program that requests services from a server.</descrip>
          <termSec>
            <term>client</term>
            <termNote type="partOfSpeech">noun</termNote>
            <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
          </termSec>
        </langSec>
        <langSec xml:lang="tr">
          <termSec>
            <term>istemci</term>
            <termNote type="partOfSpeech">noun</termNote>
            <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
          </termSec>
        </langSec>
      </conceptEntry>
      <conceptEntry id="c017">
        <descrip type="subjectField">information technology</descrip>
        <langSec xml:lang="en">
          <descrip type="definition">An online service that keeps data on remote servers that users reach through the internet.</descrip>
          <termSec>
            <term>cloud storage</term>
            <termNote type="partOfSpeech">noun</termNote>
            <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
          </termSec>
        </langSec>
        <langSec xml:lang="tr">
          <termSec>
            <term>bulut depolama</term>
            <termNote type="partOfSpeech">noun</termNote>
            <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
          </termSec>
        </langSec>
      </conceptEntry>
      <conceptEntry id="c018">
        <descrip type="subjectField">information technology</descrip>
        <langSec xml:lang="en">
          <descrip type="definition">A screen area where users give instructions to the computer by typing lines of text.</descrip>
          <termSec>
            <term>command line</term>
            <termNote type="partOfSpeech">noun</termNote>
            <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
          </termSec>
        </langSec>
        <langSec xml:lang="tr">
          <termSec>
            <term>komut satırı</term>
            <termNote type="partOfSpeech">noun</termNote>
            <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
          </termSec>
        </langSec>
      </conceptEntry>
      <conceptEntry id="c019">
        <descrip type="subjectField">information technology</descrip>
        <langSec xml:lang="en">
          <descrip type="definition">A program that translates source code into machine code or another lower-level form.</descrip>
          <termSec>
            <term>compiler</term>
            <termNote type="partOfSpeech">noun</termNote>
            <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
          </termSec>
        </langSec>
        <langSec xml:lang="tr">
          <termSec>
            <term>derleyici</term>
            <termNote type="partOfSpeech">noun</termNote>
            <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
          </termSec>
        </langSec>
      </conceptEntry>
      <conceptEntry id="c020">
        <descrip type="subjectField">information technology</descrip>
        <langSec xml:lang="en">
          <descrip type="definition">Reducing the size of data so that it takes less storage space or transfers faster.</descrip>
          <termSec>
            <term>compression</term>
            <termNote type="partOfSpeech">noun</termNote>
            <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
          </termSec>
        </langSec>
        <langSec xml:lang="tr">
          <termSec>
            <term>sıkıştırma</term>
            <termNote type="partOfSpeech">noun</termNote>
            <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
          </termSec>
        </langSec>
      </conceptEntry>
      <conceptEntry id="c021">
        <descrip type="subjectField">information technology</descrip>
        <langSec xml:lang="en">
          <descrip type="definition">The set of options and settings that determine how a system or program behaves.</descrip>
          <termSec>
            <term>configuration</term>
            <termNote type="partOfSpeech">noun</termNote>
            <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
          </termSec>
        </langSec>
        <langSec xml:lang="tr">
          <termSec>
            <term>yapılandırma</term>
            <termNote type="partOfSpeech">noun</termNote>
            <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
          </termSec>
        </langSec>
      </conceptEntry>
      <conceptEntry id="c022">
        <descrip type="subjectField">information technology</descrip>
        <langSec xml:lang="en">
          <descrip type="definition">A link between two devices, programs, or systems that lets them exchange data.</descrip>
          <termSec>
            <term>connection</term>
            <termNote type="partOfSpeech">noun</termNote>
            <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
          </termSec>
        </langSec>
        <langSec xml:lang="tr">
          <termSec>
            <term>bağlantı</term>
            <termNote type="partOfSpeech">noun</termNote>
            <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
          </termSec>
        </langSec>
      </conceptEntry>
      <conceptEntry id="c023">
        <descrip type="subjectField">information technology</descrip>
        <langSec xml:lang="en">
          <descrip type="definition">A small file that a website stores on a user's device to remember information about a visit.</descrip>
          <termSec>
            <term>cookie</term>
            <termNote type="partOfSpeech">noun</termNote>
            <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
          </termSec>
        </langSec>
        <langSec xml:lang="tr">
          <termSec>
            <term>çerez</term>
            <termNote type="partOfSpeech">noun</termNote>
            <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
          </termSec>
        </langSec>
      </conceptEntry>
      <conceptEntry id="c024">
        <descrip type="subjectField">information technology</descrip>
        <langSec xml:lang="en">
          <descrip type="definition">The symbol on a screen that shows where the next action or text input will take place.</descrip>
          <termSec>
            <term>cursor</term>
            <termNote type="partOfSpeech">noun</termNote>
            <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
          </termSec>
        </langSec>
        <langSec xml:lang="tr">
          <termSec>
            <term>imleç</term>
            <termNote type="partOfSpeech">noun</termNote>
            <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
          </termSec>
        </langSec>
      </conceptEntry>
      <conceptEntry id="c025">
        <descrip type="subjectField">information technology</descrip>
        <langSec xml:lang="en">
          <descrip type="definition">A single screen that gathers key information and controls in one place.</descrip>
          <termSec>
            <term>dashboard</term>
            <termNote type="partOfSpeech">noun</termNote>
            <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
          </termSec>
        </langSec>
        <langSec xml:lang="tr">
          <termSec>
            <term>pano</term>
            <termNote type="partOfSpeech">noun</termNote>
            <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
          </termSec>
        </langSec>
      </conceptEntry>
      <conceptEntry id="c026">
        <descrip type="subjectField">information technology</descrip>
        <langSec xml:lang="en">
          <descrip type="definition">Facts, figures, or other information in a form that a computer can store and process.</descrip>
          <termSec>
            <term>data</term>
            <termNote type="partOfSpeech">noun</termNote>
            <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
          </termSec>
        </langSec>
        <langSec xml:lang="tr">
          <termSec>
            <term>veri</term>
            <termNote type="partOfSpeech">noun</termNote>
            <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
          </termSec>
        </langSec>
      </conceptEntry>
      <conceptEntry id="c027">
        <descrip type="subjectField">information technology</descrip>
        <langSec xml:lang="en">
          <descrip type="definition">Structured information kept in a system so that it can be stored, searched, and changed efficiently.</descrip>
          <termSec>
            <term>database</term>
            <termNote type="partOfSpeech">noun</termNote>
            <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
          </termSec>
        </langSec>
        <langSec xml:lang="tr">
          <termSec>
            <term>veritabanı</term>
            <termNote type="partOfSpeech">noun</termNote>
            <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
          </termSec>
        </langSec>
      </conceptEntry>
      <conceptEntry id="c028">
        <descrip type="subjectField">information technology</descrip>
        <langSec xml:lang="en">
          <descrip type="definition">Tracking down why a program misbehaves and correcting the cause.</descrip>
          <termSec>
            <term>debugging</term>
            <termNote type="partOfSpeech">noun</termNote>
            <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
          </termSec>
        </langSec>
        <langSec xml:lang="tr">
          <termSec>
            <term>hata ayıklama</term>
            <termNote type="partOfSpeech">noun</termNote>
            <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
          </termSec>
        </langSec>
      </conceptEntry>
      <conceptEntry id="c029">
        <descrip type="subjectField">information technology</descrip>
        <langSec xml:lang="en">
          <descrip type="definition">A setting or value that is used automatically unless the user chooses another one.</descrip>
          <termSec>
            <term>default</term>
            <termNote type="partOfSpeech">adjective</termNote>
            <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
          </termSec>
        </langSec>
        <langSec xml:lang="tr">
          <termSec>
            <term>varsayılan</term>
            <termNote type="partOfSpeech">adjective</termNote>
            <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
          </termSec>
        </langSec>
      </conceptEntry>
      <conceptEntry id="c030">
        <descrip type="subjectField">information technology</descrip>
        <langSec xml:lang="en">
          <descrip type="definition">The main screen of an operating system, on which icons, windows, and files are shown.</descrip>
          <termSec>
            <term>desktop</term>
            <termNote type="partOfSpeech">noun</termNote>
            <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
          </termSec>
        </langSec>
        <langSec xml:lang="tr">
          <termSec>
            <term>masaüstü</term>
            <termNote type="partOfSpeech">noun</termNote>
            <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
          </termSec>
        </langSec>
      </conceptEntry>
      <conceptEntry id="c031">
        <descrip type="subjectField">information technology</descrip>
        <langSec xml:lang="en">
          <descrip type="definition">A small window that asks the user for information or for a confirmation.</descrip>
          <termSec>
            <term>dialog box</term>
            <termNote type="partOfSpeech">noun</termNote>
            <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
          </termSec>
        </langSec>
        <langSec xml:lang="tr">
          <termSec>
            <term>iletişim kutusu</term>
            <termNote type="partOfSpeech">noun</termNote>
            <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
          </termSec>
        </langSec>
      </conceptEntry>
      <conceptEntry id="c032">
        <descrip type="subjectField">information technology</descrip>
        <langSec xml:lang="en">
          <descrip type="definition">A named space on a storage device that groups related files and can also hold other such spaces.</descrip>
          <termSec>
            <term>directory</term>
            <termNote type="partOfSpeech">noun</termNote>
            <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
          </termSec>
        </langSec>
        <langSec xml:lang="tr">
          <termSec>
            <term>dizin</term>
            <termNote type="partOfSpeech">noun</termNote>
            <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
          </termSec>
        </langSec>
      </conceptEntry>
